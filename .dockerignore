# Send only build inputs. Web functions, credentials, worlds and caches stay out.
**
!Dockerfile
!.dockerignore
!requirements.txt
!LICENSE
!THIRD_PARTY.md
!tools/
!tools/build.py
!packs/
!packs/*.yaml
!templates/
!templates/**
!docs/
!docs/voice-chat.md
!docs/backups.md
!docker/
!docker/runtime.py
# Release target: include only immutable, verified server payloads.
!build/
!build/*/
!build/*/server/
!build/*/server/mods/
!build/*/server/mods/*.jar
!build/*/server/config/
!build/*/server/config/**
!build/*/server/docs/
!build/*/server/docs/*.md
!build/*/server/fabric-server-launch.jar
!build/*/server/pack.lock.json
!build/*/server/server.properties
!build/*/server/server-icon.png
!build/*/server/eula.txt
!build/*/server/start.sh
!build/*/server/start.bat
!build/*/server/fastback.py
!build/*/server/LICENSE
!build/*/server/THIRD_PARTY.md
!build/*/server/README.md
!build/*/server/MODS.md
!build/*/server/SHA512SUMS.txt
