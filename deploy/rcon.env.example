# Copy to deploy/rcon.env and set your own password before using the RCON overlay.
# Keep the real file private. Single quotes preserve literal dollar signs in Compose env files.
MC_RCON_PASSWORD=''
MC_RCON_PORT=25575
MC_RCON_HOST_PORT=25575
# Default access is from the Docker host. Use an SSH tunnel for remote administration.
MC_RCON_BIND_IP=127.0.0.1
