# 首次部署复制为 .env；已有配置请合并字段。
# Release 附件使用对应发布的镜像摘要；源码模板跟随 latest。
MC_IMAGE=docker.cnb.cool/mintimate/tool-forge/minecraft-vanilla-stack/vanilla-plus:latest

# 开发构建：docker compose -f compose.yaml -f compose.build.yaml up -d --build
PACK_ID=vanilla-plus
MC_BUILD_IMAGE=minecraft-vanilla-stack-server:local

# Docker 自动创建命名卷，无需首次 mkdir/chown。更名会切换卷，不会迁移世界。
MC_DATA_VOLUME=minecraft-vanilla-stack-data
MC_BACKUP_VOLUME=minecraft-vanilla-stack-backups

# 阅读 https://www.minecraft.net/eula 后，仅在自行同意时改为 true。
EULA=false

# 游戏端口；默认 vanilla-plus 的近距离语音另需 24454/udp。
MC_PORT=25565
MC_MIN_MEMORY=1G
MC_MAX_MEMORY=4G
MC_CONTAINER_MEMORY=6g
MC_CPUS=4

# 可选：可信的 Minecraft 官方 HTTP 服务代理 HTTPS 基础地址。
# 留空时直接连接官方服务；游戏 TCP 与语音 UDP 不经过该代理。
MC_SERVICE_PROXY_URL=

# 原生 RCON 默认关闭；仅有密码不会启用。
# 需要宿主端口时使用 deploy/compose.rcon.yaml 和 deploy/rcon.env.example。
MC_RCON_ENABLED=false

# 更换 Minecraft 版本前先冷备，在副本验证。仅本次升级明确开启，完成后恢复 false。
ALLOW_MINECRAFT_VERSION_CHANGE=false
