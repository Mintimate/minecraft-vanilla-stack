# Runtime secrets: configure these in Makers project environment variables.
# Never use a PUBLIC_/VITE_ prefix or copy real values into frontend files.
ADMIN_KEY=
RCON_HOST=
RCON_PASSWORD=

# Optional; defaults to 25575.
RCON_PORT=25575

# Optional structured-log verbosity: debug | info | warn | error (default info).
# LOG_LEVEL=info

# Optional Minecraft authentication proxy: this deployment's public HTTPS origin.
# Required only for /mc-proxy/*; no path, query, credentials or fragment.
# Configure on Makers, then set MC_SERVICE_PROXY_URL on the game server separately.
MC_PROXY_PUBLIC_ORIGIN=
# Example: MC_PROXY_PUBLIC_ORIGIN=https://minecraft.example.com

# ADMIN_KEY: at least 32 bytes; RCON_PASSWORD: 32-128 printable ASCII, no spaces.
# Use different random values for the two keys.
# RCON is not encrypted. Use a reachable private/protected network endpoint.
# Do not expose bare RCON publicly. A cloud function cannot reach game-host localhost.
# Local preview only: use loopback and disposable test secrets.
# RCON_HOST=127.0.0.1
